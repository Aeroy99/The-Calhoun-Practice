# Copy to cms/.env for local SQLite. Production secrets live in Vercel only.

# Required
PAYLOAD_SECRET=replace-with-a-long-random-string
DATABASE_URL=file:./payload-demo.db

# Public CMS origin (local)
NEXT_PUBLIC_SERVER_URL=http://localhost:3000
PREVIEW_URL=http://localhost:5173
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173,http://localhost:3000
CSRF_ORIGINS=http://localhost:3000

# First admin — created by yarn seed / yarn ensure-admin / production build
PAYLOAD_ADMIN_EMAIL=you@thecalhounpractice.com
PAYLOAD_ADMIN_PASSWORD=replace-with-12-plus-chars
PAYLOAD_ADMIN_NAME=Aaron

# Optional: allow the first /admin create form in local only
# ALLOW_PUBLIC_FIRST_USER=true

# Media on Vercel (create a Blob store on the CMS project)
# BLOB_READ_WRITE_TOKEN=

# Password reset email (SMTP)
# EMAIL_FROM=noreply@thecalhounpractice.com
# SMTP_HOST=
# SMTP_PORT=587
# SMTP_USER=
# SMTP_PASS=

# Tests / CI
# PAYLOAD_DISABLE_TOTP=true
