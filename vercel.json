{
  "redirects": [
    {
      "source": "/admin",
      "destination": "https://cms.thecalhounpractice.com/admin",
      "permanent": false
    },
    {
      "source": "/admin/:path*",
      "destination": "https://cms.thecalhounpractice.com/admin/:path*",
      "permanent": false
    }
  ],
  "rewrites": [
    {
      "source": "/((?!assets|favicon\\.svg).*)",
      "destination": "/index.html"
    }
  ]
}
